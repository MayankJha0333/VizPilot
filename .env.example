# ---------- MongoDB (required) ----------
# Paste the connection string from MongoDB Atlas. If it still contains
# <db_username>/<db_password> placeholders, fill MONGODB_USERNAME/PASSWORD too.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DB=vizpilot

# ---------- Firebase Auth (required) ----------
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Local development without a Firebase project: run `npm run emulators` and set
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# (with NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-vizpilot and any NEXT_PUBLIC_FIREBASE_API_KEY)

# ---------- AI (optional) ----------
# Add any of these. Providers are tried in this order and fall back automatically
# when one fails, rate-limits or times out (see Settings → AI providers in the app).
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=
ZAI_API_KEY=
HUGGINGFACE_API_KEY=
# Optional: change the order (comma-separated ids: groq,gemini,mistral,github,openrouter,zai,huggingface)
# AI_PROVIDER_ORDER=groq,gemini,mistral,github,openrouter,zai,huggingface
